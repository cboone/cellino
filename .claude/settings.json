{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(zig build *)",
      "Bash(zig fmt *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh issue view *)",
      "Bash(npm run format:check)",
      "Bash(npm run lint:md)",
      "Bash(typos)",
      "Bash(typos --format brief)",
      "Bash(actionlint)",
      "Bash(gitleaks detect *)",
      "Bash(shellcheck *)"
    ],
    "deny": []
  }
}
