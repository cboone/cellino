# Make the `engines` constraint in package.json a hard error rather than a
# warning. Without this, npm prints EBADENGINE and installs anyway, so an
# unsupported Node version surfaces later as a confusing failure inside
# markdownlint rather than at install time, which is the point of declaring it.
#
# markdownlint-cli2 0.23.2, markdownlint 0.41.1 and
# markdownlint-rule-relative-links 5.1.2 all require Node >=22, measured with
# `npm view <package>@<version> engines` on 2026-09-14. That is the highest
# requirement anywhere in the tree; Prettier 3.9.6 asks only for >=14.
engine-strict=true
