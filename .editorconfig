# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# zig fmt is the authority for both. This only keeps editors from fighting it.
[*.{zig,zon}]
indent_style = space
indent_size = 4

[*.{c,cpp,h}]
indent_style = space
indent_size = 4

[CMakeLists.txt]
indent_style = space
indent_size = 4

[*.{json,jsonc,toml,yml,yaml}]
indent_style = space
indent_size = 2

# markdownlint's MD009 already governs trailing whitespace here and allows the
# two spaces that mean a hard line break. Nothing relies on that today; this
# keeps the editor from stripping it before markdownlint can have an opinion.
[*.md]
trim_trailing_whitespace = false

# The shell section arrives with Phase 1's first script. It will carry
# shfmt-specific keys, which shfmt reads from this file natively. That support
# is all-or-nothing: passing any formatting flag makes shfmt ignore
# .editorconfig entirely, so `shfmt -d` is correct and `shfmt -i 2 -d` silently
# is not. Scripts under scripts/ and cmake/ have no extension, so a bare
# [*.sh] section would not reach them and each has to be named individually.
#
# A Python section arrives with Phase 2's harness. ruff ignores this file, so
# that section and ruff.toml will be two statements of one style, with
# ruff.toml the authority.
